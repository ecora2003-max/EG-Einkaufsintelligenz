{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ecora2003-max/EG-Architecture/blob/main/contracts/v1.1/contract.schema.json",
  "title": "Ernährungsgedächtnis interchange messages (shopping extensions, draft)",
  "description": "Additive 1.1.0-draft interchange schema, self-contained; v1.0 is unchanged. No actual stock/purchase/nutrition write commands.",
  "type": "object",
  "required": [
    "contractVersion",
    "messageType",
    "meta",
    "payload"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.1.0-draft"
    },
    "messageType": {
      "enum": [
        "price.observation",
        "product.match",
        "receipt.line",
        "comparison.result",
        "recipe.draft",
        "shopping.need.projection",
        "shopping.purchase.suggestion",
        "shopping.offer.interest",
        "shopping.past.comparison"
      ]
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "messageType": {
            "const": "price.observation"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/PriceObservation"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "messageType": {
            "const": "product.match"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/ProductMatch"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "messageType": {
            "const": "receipt.line"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/ReceiptLine"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "messageType": {
            "const": "comparison.result"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/ComparisonResult"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "messageType": {
            "const": "recipe.draft"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/RecipeDraft"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "messageType": {
            "const": "shopping.need.projection"
          }
        },
        "required": [
          "messageType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/ShoppingNeedProjection"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "messageType": {
            "const": "shopping.purchase.suggestion"
          }
        },
        "required": [
          "messageType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/ShoppingPurchaseSuggestion"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "messageType": {
            "const": "shopping.offer.interest"
          }
        },
        "required": [
          "messageType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/ShoppingOfferInterest"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "messageType": {
            "const": "shopping.past.comparison"
          }
        },
        "required": [
          "messageType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/ShoppingPastComparison"
          }
        }
      }
    }
  ],
  "$defs": {
    "Meta": {
      "type": "object",
      "required": [
        "producer",
        "createdAt",
        "traceId"
      ],
      "properties": {
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "traceId": {
          "type": "string",
          "minLength": 1
        },
        "inputsSnapshotAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "coverageNote": {
          "type": [
            "string",
            "null"
          ]
        },
        "usageContext": {
          "enum": [
            "RESEARCH_ONLY",
            "APP_DISPLAY",
            "PRIVATE_USER_HISTORY"
          ]
        }
      },
      "additionalProperties": false
    },
    "Source": {
      "type": "object",
      "required": [
        "origin",
        "observedAt",
        "rightsStatus",
        "dataQuality"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sourceUpdatedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "evidenceKind": {
          "enum": [
            "LIVE_RESPONSE",
            "OFFICIAL_WEB",
            "USER_CONFIRMED_RECEIPT",
            "THIRD_PARTY",
            "STATIC_ANALYSIS",
            "ESTIMATE",
            "UNKNOWN"
          ]
        },
        "rightsStatus": {
          "enum": [
            "PERMITTED",
            "UNVERIFIED",
            "RESTRICTED"
          ]
        },
        "dataQuality": {
          "enum": [
            "CONFIRMED",
            "SOURCED",
            "ESTIMATED",
            "UNKNOWN"
          ]
        },
        "parserVersion": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "Scope": {
      "type": "object",
      "required": [
        "retailerId",
        "scopeType"
      ],
      "properties": {
        "retailerId": {
          "type": "string",
          "minLength": 1
        },
        "storeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "scopeType": {
          "enum": [
            "STORE_CONFIRMED",
            "REGION_CONFIRMED",
            "CHAIN_WIDE_REPORTED",
            "ONLINE",
            "UNKNOWN"
          ]
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scopeType": {
                "const": "STORE_CONFIRMED"
              }
            }
          },
          "then": {
            "required": [
              "storeId"
            ],
            "properties": {
              "storeId": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "Quantity": {
      "type": "object",
      "required": [
        "amount",
        "unit",
        "basis",
        "confirmed"
      ],
      "properties": {
        "amount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Integer in specified unit. Null means unknown; no automatic conversion between piece and g/ml."
        },
        "unit": {
          "enum": [
            "g",
            "ml",
            "portion",
            "piece"
          ]
        },
        "basis": {
          "enum": [
            "NET",
            "DRAINED",
            "GROSS",
            "PIECE",
            "PER_PORTION",
            "UNKNOWN"
          ]
        },
        "confirmed": {
          "type": "boolean"
        },
        "packageCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "Article": {
      "type": "object",
      "required": [
        "label",
        "organic",
        "brandKind"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "foodTypeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "gtin": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{8}([0-9]{4}([0-9]{1}([0-9]{1})?)?)?$"
        },
        "retailerArticleId": {
          "type": [
            "string",
            "null"
          ]
        },
        "brandName": {
          "type": [
            "string",
            "null"
          ]
        },
        "brandKind": {
          "enum": [
            "MANUFACTURER",
            "PRIVATE_LABEL",
            "UNKNOWN"
          ]
        },
        "organic": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "quantity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "PriceObservation": {
      "type": "object",
      "required": [
        "observationId",
        "article",
        "scope",
        "priceCents",
        "currency",
        "priceKind",
        "source"
      ],
      "properties": {
        "observationId": {
          "type": "string",
          "minLength": 1
        },
        "article": {
          "$ref": "#/$defs/Article"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "priceCents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "const": "EUR"
        },
        "priceKind": {
          "enum": [
            "SALE",
            "CURRENT_DISPLAYED",
            "LISTED_REGULAR",
            "REFERENCE_OLD",
            "HISTORICAL_PAID",
            "ONLINE_LISTED",
            "UNKNOWN"
          ]
        },
        "validFrom": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "validUntil": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "depositCents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "conditional": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "availability": {
          "enum": [
            "IN_STOCK_REPORTED",
            "OUT_OF_STOCK_REPORTED",
            "UNKNOWN"
          ]
        }
      },
      "additionalProperties": true
    },
    "ProductMatch": {
      "type": "object",
      "required": [
        "requestId",
        "candidate",
        "matchLevel",
        "status",
        "evidence"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "candidate": {
          "$ref": "#/$defs/Article"
        },
        "matchLevel": {
          "enum": [
            "EXACT_SKU",
            "SAME_FOOD_VARIANT",
            "FUNCTIONAL_SUBSTITUTE",
            "NOT_COMPARABLE",
            "UNKNOWN"
          ]
        },
        "status": {
          "enum": [
            "CONFIRMED_BY_USER",
            "SUGGESTED",
            "AMBIGUOUS",
            "REJECTED",
            "UNKNOWN"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "ReceiptLine": {
      "type": "object",
      "required": [
        "lineId",
        "receiptId",
        "retailerId",
        "rawText",
        "lineKind",
        "confirmed"
      ],
      "properties": {
        "lineId": {
          "type": "string",
          "minLength": 1
        },
        "receiptId": {
          "type": "string",
          "minLength": 1
        },
        "retailerId": {
          "type": "string",
          "minLength": 1
        },
        "storeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "rawText": {
          "type": "string"
        },
        "lineKind": {
          "enum": [
            "FOOD",
            "NON_FOOD",
            "DEPOSIT",
            "DISCOUNT",
            "RETURN",
            "UNKNOWN"
          ]
        },
        "amountCents": {
          "type": [
            "integer",
            "null"
          ]
        },
        "quantity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "confirmed": {
          "type": "boolean"
        },
        "purchaseAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "gtin": {
          "type": [
            "string",
            "null"
          ]
        },
        "retailerArticleId": {
          "type": [
            "string",
            "null"
          ]
        },
        "linkedArticle": {
          "anyOf": [
            {
              "$ref": "#/$defs/Article"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Source"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "ComparisonAlternative": {
      "type": "object",
      "required": [
        "observationId",
        "pricePerBaseUnitMilliCents",
        "basis",
        "comparability",
        "priceDifferenceCents"
      ],
      "properties": {
        "observationId": {
          "type": "string",
          "minLength": 1
        },
        "pricePerBaseUnitMilliCents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Illustrative optional precomputed rate; basis must specify comparator. Deterministic comparison engine may instead carry exact numerator/denominator."
        },
        "basis": {
          "enum": [
            "kg",
            "l",
            "piece",
            "unknown"
          ]
        },
        "comparability": {
          "enum": [
            "EXACT_SKU",
            "SAME_FOOD_VARIANT",
            "FUNCTIONAL_SUBSTITUTE",
            "UNKNOWN"
          ]
        },
        "bioDifference": {
          "enum": [
            "SAME",
            "DIFFERENT",
            "UNKNOWN"
          ]
        },
        "priceDifferenceCents": {
          "type": [
            "integer",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "ComparisonResult": {
      "type": "object",
      "required": [
        "comparisonId",
        "targetObservationId",
        "shoppingDate",
        "alternatives",
        "signals",
        "incomplete"
      ],
      "properties": {
        "comparisonId": {
          "type": "string",
          "minLength": 1
        },
        "targetObservationId": {
          "type": "string",
          "minLength": 1
        },
        "shoppingDate": {
          "type": "string",
          "format": "date"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComparisonAlternative"
          }
        },
        "signals": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "RED_SAME_BIO_CHEAPER",
              "ORANGE_DIFFERENT_BIO_CHEAPER",
              "GREY_MAY_BE_CHEAPER"
            ]
          }
        },
        "incomplete": {
          "type": "boolean"
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "Ingredient": {
      "type": "object",
      "required": [
        "label",
        "quantity",
        "sourceStatus"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "foodTypeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "productRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "quantity": {
          "$ref": "#/$defs/Quantity"
        },
        "sourceStatus": {
          "enum": [
            "CONFIRMED",
            "SOURCED",
            "ESTIMATED",
            "UNKNOWN"
          ]
        },
        "allergenNotes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "RecipeDraft": {
      "type": "object",
      "required": [
        "draftId",
        "title",
        "portionCount",
        "ingredients",
        "steps",
        "flags",
        "warnings"
      ],
      "properties": {
        "draftId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "portionCount": {
          "type": "integer",
          "minimum": 1
        },
        "ingredients": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Ingredient"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "flags": {
          "type": "object",
          "required": [
            "considerStock",
            "considerShopping",
            "considerOffers"
          ],
          "properties": {
            "considerStock": {
              "type": "boolean"
            },
            "considerShopping": {
              "type": "boolean"
            },
            "considerOffers": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "nutrition": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "const": "DRAFT"
        }
      },
      "additionalProperties": true
    },
    "ShoppingNeed": {
      "type": "object",
      "required": [
        "needId",
        "foodTypeId",
        "dueDate",
        "quantity",
        "stockEvidenceRefs",
        "completeness",
        "warnings"
      ],
      "properties": {
        "needId": {
          "type": "string",
          "minLength": 1
        },
        "foodTypeId": {
          "type": "string",
          "minLength": 1
        },
        "dueDate": {
          "type": "string",
          "format": "date"
        },
        "quantity": {
          "$ref": "#/$defs/Quantity"
        },
        "stockEvidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "planRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "completeness": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "UNKNOWN"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "ShoppingNeedProjection": {
      "type": "object",
      "required": [
        "snapshotAt",
        "asOf",
        "horizonDays",
        "needs",
        "completeness",
        "warnings"
      ],
      "properties": {
        "snapshotAt": {
          "type": "string",
          "format": "date-time"
        },
        "asOf": {
          "type": "string",
          "format": "date-time"
        },
        "horizonDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "horizonMode": {
          "const": "CUMULATIVE_FROM_SNAPSHOT"
        },
        "needs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ShoppingNeed"
          }
        },
        "completeness": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "UNKNOWN"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourceSnapshotRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unknownNeeds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ShoppingUnknownNeed"
          },
          "description": "Needs with unknown amount/unit preserved outside typed Quantity; require PARTIAL or UNKNOWN overall completeness."
        }
      },
      "additionalProperties": true
    },
    "ShoppingPurchaseSuggestion": {
      "type": "object",
      "required": [
        "suggestionId",
        "needIds",
        "productId",
        "observationRefs",
        "quantity",
        "packageCount",
        "expectedCents",
        "checkoutCents",
        "status",
        "warnings"
      ],
      "properties": {
        "suggestionId": {
          "type": "string",
          "minLength": 1
        },
        "needIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "productId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "observationRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "quantity": {
          "$ref": "#/$defs/Quantity"
        },
        "packageCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "expectedCents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "checkoutCents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "budgetPeriod": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "from",
                "until"
              ],
              "properties": {
                "from": {
                  "type": "string",
                  "format": "date"
                },
                "until": {
                  "type": "string",
                  "format": "date"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "capacityEvidence": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "snapshotAt": {
              "type": "string",
              "format": "date-time"
            },
            "scope": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "status": {
          "enum": [
            "REVIEW",
            "FEASIBLE_NOT_PURCHASED",
            "UNKNOWN"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "termsVerified": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "scopeType": {
          "enum": [
            "STORE_CONFIRMED",
            "REGION_CONFIRMED",
            "CHAIN_WIDE_REPORTED",
            "ONLINE",
            "UNKNOWN"
          ]
        },
        "packageLines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ShoppingPackageLine"
          },
          "description": "Typed multi-SKU selection; totals and each row must be backed by original observation, price, deposit and store evidence."
        }
      },
      "additionalProperties": true
    },
    "ShoppingOfferInterest": {
      "type": "object",
      "required": [
        "interestId",
        "productId",
        "foodTypeId",
        "action",
        "effectiveAt",
        "sourceOfferIds",
        "proposedState"
      ],
      "properties": {
        "interestId": {
          "type": "string",
          "minLength": 1
        },
        "productId": {
          "type": [
            "string",
            "null"
          ]
        },
        "foodTypeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "action": {
          "enum": [
            "INTERESTED",
            "UNDECIDED",
            "NOT_TODAY",
            "HIDE_PRODUCT",
            "HIDE_FOOD_TYPE",
            "ADD_TO_SHOPPING_LIST"
          ]
        },
        "effectiveAt": {
          "type": "string",
          "format": "date-time"
        },
        "sourceOfferIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "proposedState": {
          "type": "object"
        },
        "confirmed": {
          "const": false
        }
      },
      "anyOf": [
        {
          "properties": {
            "productId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "productId"
          ]
        },
        {
          "properties": {
            "foodTypeId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "foodTypeId"
          ]
        }
      ],
      "additionalProperties": true
    },
    "ShoppingPastComparison": {
      "type": "object",
      "required": [
        "confirmedPurchaseRef",
        "purchaseAt",
        "evidenceCutoff",
        "storeScope",
        "matchedHistoricalOfferIds",
        "rejectedReasons",
        "savingsProvenCents",
        "warnings",
        "savingsBasis"
      ],
      "properties": {
        "confirmedPurchaseRef": {
          "type": "string",
          "minLength": 1
        },
        "purchaseAt": {
          "type": "string",
          "format": "date-time"
        },
        "evidenceCutoff": {
          "type": "string",
          "format": "date-time"
        },
        "storeScope": {
          "$ref": "#/$defs/Scope"
        },
        "matchedHistoricalOfferIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rejectedReasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "savingsProvenCents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unitOnlyAlternatives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "PROVEN",
            "INCOMPLETE",
            "NO_COMPARABLE_OFFER"
          ]
        },
        "savingsBasis": {
          "const": "MERCHANDISE_ONLY",
          "description": "savingsProvenCents means proven merchandise outlay reduction, not checkout cash or unit-only price change."
        }
      },
      "additionalProperties": true
    },
    "ShoppingUnknownNeed": {
      "type": "object",
      "description": "Unresolved need whose unit must not be invented; not a fulfilled or zero-amount need.",
      "required": [
        "needId",
        "foodTypeId",
        "dueDate",
        "quantityToBuy",
        "reason"
      ],
      "properties": {
        "needId": {
          "type": "string",
          "minLength": 1
        },
        "foodTypeId": {
          "type": "string",
          "minLength": 1
        },
        "dueDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "quantityToBuy": {
          "type": "null"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "ShoppingPackageLine": {
      "type": "object",
      "description": "One selected package line, with its own product, original price evidence and checkout components. Unknown is null.",
      "required": [
        "productId",
        "observationId",
        "packageCount",
        "quantity",
        "merchandiseCents",
        "depositCents",
        "checkoutCents",
        "retailerId",
        "storeId"
      ],
      "properties": {
        "productId": {
          "type": "string",
          "minLength": 1
        },
        "observationId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "packageCount": {
          "type": "integer",
          "minimum": 1
        },
        "quantity": {
          "$ref": "#/$defs/Quantity"
        },
        "merchandiseCents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "depositCents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "checkoutCents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "retailerId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "storeId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
